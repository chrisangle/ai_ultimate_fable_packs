{
  "id": "bedtime-tales-en",
  "name": {
    "en": "Bedtime Tales",
    "vi": "Chuyện Kể Trước Giờ Ngủ"
  },
  "version": "0.1.4",
  "description": {
    "en": "Cozy storybook-style bedtime tales for kids, warm English narrator, 3–6 minute videos.",
    "vi": "Truyện kể trước giờ ngủ cho trẻ em, phong cách sách tranh ấm áp, người dẫn tiếng Anh, video 3–6 phút."
  },
  "author": "aivideoultimate",
  "license": "MIT",
  "repository": "https://github.com/chrisangle/ai_ultimate_fable_packs",
  "target": {
    "language": "en",
    "market": [
      "en-US",
      "en-GB",
      "en-CA",
      "en-AU"
    ],
    "audience": "kids",
    "genre": "bedtime-story",
    "aspectRatio": "16:9",
    "supportedAspects": [
      "16:9"
    ],
    "duration": {
      "min": 180,
      "target": 300,
      "max": 360
    }
  },
  "compat": {
    "core": ">=1.1.0"
  },
  "assets": {
    "templates": "templates",
    "characters": "characters",
    "sfx": "sfx",
    "voice": "voice",
    "style": "style/tokens.css"
  },
  "prompts": {
    "script": "prompts/script.md"
  },
  "voice": {
    "referenceClip": "voice/ref-narrator-en.mp3",
    "defaultVoiceId": "bedtime-narrator-en",
    "language": "en"
  },
  "scenes": {
    "defaultTemplate": "storybook-page",
    "hookTemplate": "hook-title",
    "outroTemplate": "end-card",
    "beatStructure": [
      "hook",
      "setup",
      "problem",
      "resolution",
      "moral",
      "outro"
    ]
  },
  "wizard": {
    "supportsUrl": false,
    "ideaPlaceholder": {
      "en": "e.g. A cozy little fox loses her mittens in the winter forest — and finds them by helping the other animals.",
      "vi": "VD: Chú cáo nhỏ đánh rơi găng tay trong rừng mùa đông — tìm lại được nhờ giúp đỡ các bạn."
    }
  },
  "templateCatalog": {
    "hook-title": {
      "id": "hook-title",
      "name": {
        "en": "Hook Title",
        "vi": "Trang Mở Đầu"
      },
      "description": {
        "en": "Cozy opening — moon + twinkling stars + purple night sky + centered book with story title. Use ONCE as scene 1.",
        "vi": "Mở đầu ấm áp — trăng + sao lấp lánh + bầu trời đêm tím + cuốn sách chứa tựa truyện. Dùng MỘT LẦN cho cảnh 1."
      },
      "role": "hook",
      "slots": {
        "kicker": {
          "type": "string",
          "required": true,
          "maxLength": 32,
          "label": {
            "en": "Kicker (small caps)",
            "vi": "Kicker (chữ in nhỏ)"
          }
        },
        "title": {
          "type": "string",
          "required": true,
          "maxLength": 80,
          "label": {
            "en": "Story title inside the book",
            "vi": "Tựa truyện trong sách"
          }
        },
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 120,
          "label": {
            "en": "Warm invitation caption",
            "vi": "Caption lời mời ấm áp"
          }
        }
      }
    },
    "storybook-page": {
      "id": "storybook-page",
      "name": {
        "en": "Storybook Page",
        "vi": "Trang Sách"
      },
      "description": {
        "en": "Body — parchment spread with a soft illustration on the left, heading + body copy on the right, chapter/page number. Default for every scene beat.",
        "vi": "Body — trang giấy da với minh họa nhẹ nhàng bên trái, tiêu đề + nội dung bên phải, số chương/trang. Mặc định cho mọi nhịp truyện."
      },
      "role": "body",
      "slots": {
        "order": {
          "type": "string",
          "required": true,
          "maxLength": 3,
          "label": {
            "en": "Chapter / page number",
            "vi": "Số chương / trang"
          },
          "help": {
            "en": "1, 2, 3…",
            "vi": "1, 2, 3…"
          }
        },
        "heading": {
          "type": "string",
          "required": true,
          "maxLength": 40,
          "label": {
            "en": "Heading (sentence case)",
            "vi": "Tiêu đề (chữ thường)"
          }
        },
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 260,
          "label": {
            "en": "Body copy (narrator reads this)",
            "vi": "Nội dung (người dẫn đọc)"
          }
        }
      }
    },
    "end-card": {
      "id": "end-card",
      "name": {
        "en": "End Card",
        "vi": "Thẻ Kết Thúc"
      },
      "description": {
        "en": "Closing — night sky + moon + italic 'The End' + sweet-dreams caption. Use ONCE as the last scene.",
        "vi": "Kết — bầu trời đêm + trăng + chữ nghiêng 'The End' + caption chúc ngủ ngon. Dùng MỘT LẦN cho cảnh cuối."
      },
      "role": "outro",
      "slots": {
        "endTitle": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "label": {
            "en": "End title (default: The End)",
            "vi": "Tựa kết (mặc định: The End)"
          }
        },
        "sub": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "label": {
            "en": "Subtitle (default: Sweet Dreams)",
            "vi": "Phụ đề (mặc định: Sweet Dreams)"
          }
        },
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 100,
          "label": {
            "en": "Goodnight caption",
            "vi": "Caption chúc ngủ ngon"
          }
        }
      }
    },
    "character-moment": {
      "id": "character-moment",
      "name": {
        "en": "Character Moment",
        "vi": "Khoảnh Khắc Nhân Vật"
      },
      "description": {
        "en": "Warm portrait circle with an emoji face + character label + heading + body copy. Use when introducing or focusing on a single character.",
        "vi": "Vòng chân dung ấm áp với emoji + nhãn nhân vật + tiêu đề + nội dung. Dùng khi giới thiệu hoặc tập trung vào một nhân vật."
      },
      "role": "body",
      "slots": {
        "name": {
          "type": "string",
          "required": true,
          "maxLength": 24,
          "label": {
            "en": "Character label (all caps)",
            "vi": "Nhãn nhân vật (in hoa)"
          }
        },
        "face": {
          "type": "string",
          "required": true,
          "maxLength": 4,
          "label": {
            "en": "Emoji face",
            "vi": "Emoji khuôn mặt"
          },
          "help": {
            "en": "One emoji only, e.g. 🧑‍🍳 🐇 🦊 👵",
            "vi": "Chỉ 1 emoji, ví dụ 🧑‍🍳 🐇 🦊 👵"
          }
        },
        "heading": {
          "type": "string",
          "required": true,
          "maxLength": 40,
          "label": {
            "en": "Short heading",
            "vi": "Tiêu đề ngắn"
          }
        },
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 220,
          "label": {
            "en": "Body copy (narrator reads)",
            "vi": "Nội dung (người dẫn đọc)"
          }
        }
      }
    },
    "question-page": {
      "id": "question-page",
      "name": {
        "en": "Question Page",
        "vi": "Trang Câu Hỏi"
      },
      "description": {
        "en": "Giant faded question mark + italic question + soft caption. Use to make the child pause and wonder — no answers, only the question.",
        "vi": "Dấu chấm hỏi mờ khổng lồ + câu hỏi in nghiêng + caption dịu. Dùng để trẻ dừng lại và suy nghĩ — không đưa đáp án, chỉ đặt câu hỏi."
      },
      "role": "body",
      "slots": {
        "prompt": {
          "type": "string",
          "required": true,
          "maxLength": 32,
          "label": {
            "en": "Prompt label (all caps)",
            "vi": "Nhãn (in hoa)"
          }
        },
        "question": {
          "type": "string",
          "required": true,
          "maxLength": 60,
          "label": {
            "en": "The question (italic)",
            "vi": "Câu hỏi (in nghiêng)"
          }
        },
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 160,
          "label": {
            "en": "Follow-up caption",
            "vi": "Caption tiếp nối"
          }
        }
      }
    },
    "quiet-moment": {
      "id": "quiet-moment",
      "name": {
        "en": "Quiet Moment",
        "vi": "Khoảnh Khắc Yên Bình"
      },
      "description": {
        "en": "Night sky + drifting fireflies + a single italic caption centered. Use for a mood beat — no action, just atmosphere.",
        "vi": "Bầu trời đêm + đom đóm trôi + 1 caption in nghiêng giữa màn hình. Dùng cho nhịp không khí — không hành động, chỉ tâm trạng."
      },
      "role": "body",
      "slots": {
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 160,
          "label": {
            "en": "Mood caption (italic)",
            "vi": "Caption tâm trạng (in nghiêng)"
          }
        }
      }
    }
  },
