{
  "id": "self-improvement-vn",
  "name": {
    "en": "Self-Improvement (VN)",
    "vi": "Tự Phát Triển Bản Thân"
  },
  "version": "1.1.0",
  "description": {
    "en": "Vietnamese doodle animation for self-improvement / productivity shorts, 60–90s vertical (Đồn Như Lời style).",
    "vi": "Doodle animation tiếng Việt cho short về self-improvement / productivity, dọc 60–90 giây (kiểu Đồn Như Lời)."
  },
  "author": "aivideoultimate",
  "license": "MIT",
  "repository": "https://github.com/chrisangle/ai_ultimate_fable_packs",

  "target": {
    "language": "vi",
    "market": ["vi-VN"],
    "audience": "adult",
    "genre": "self-improvement",
    "aspectRatio": "9:16",
    "supportedAspects": ["9:16"],
    "duration": { "min": 60, "target": 90, "max": 180 }
  },

  "compat": { "core": ">=1.0.0" },

  "assets": {
    "templates": "templates",
    "voice": "voice",
    "sfx": "sfx",
    "style": "style/tokens.css"
  },

  "prompts": {
    "script": "prompts/script.md",
    "scene": "prompts/scene.md"
  },

  "voice": {
    "referenceClip": "voice/ref-narrator-vn.mp3",
    "defaultVoiceId": "self-improvement-narrator-vn",
    "language": "vi"
  },

  "scenes": {
    "defaultTemplate": "doodle-scene",
    "hookTemplate": "big-question-hook",
    "outroTemplate": "cta-followup",
    "beatStructure": ["hook", "problem", "principle", "example", "action", "outro"]
  },

  "templateCatalog": {
    "big-question-hook": {
      "id": "big-question-hook",
      "name": {
        "en": "Big Question Hook",
        "vi": "Hook Câu Hỏi Lớn"
      },
      "description": {
        "en": "Opening — red stamp kicker + huge question headline + tilted doodle character. Use ONCE as scene 1.",
        "vi": "Mở đầu — kicker đỏ đóng dấu + câu hỏi lớn + doodle nhân vật nghiêng. Dùng MỘT LẦN cho cảnh 1."
      },
      "role": "hook",
      "slots": {
        "kicker": {
          "type": "string",
          "required": true,
          "maxLength": 24,
          "label": { "en": "Red kicker stamp", "vi": "Nhãn đỏ đóng dấu" }
        },
        "headline": {
          "type": "string",
          "required": true,
          "maxLength": 40,
          "label": { "en": "Big question", "vi": "Câu hỏi lớn" },
          "help": { "en": "1 short line that provokes curiosity", "vi": "1 câu ngắn, gây tò mò" }
        }
      }
    },
    "doodle-scene": {
      "id": "doodle-scene",
      "name": {
        "en": "Doodle Scene",
        "vi": "Cảnh Doodle"
      },
      "description": {
        "en": "Body scene — floating doodle character + centered caption pill + footer tag. Default for every body beat.",
        "vi": "Cảnh body — doodle nhân vật float + caption pill giữa + footer tag. Mặc định cho mọi beat body."
      },
      "role": "body",
      "slots": {
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 180,
          "label": { "en": "Caption (narrator reads)", "vi": "Caption (người dẫn đọc)" }
        },
        "footer": {
          "type": "string",
          "maxLength": 24,
          "label": { "en": "Footer tag", "vi": "Footer tag" },
          "help": { "en": "Small caps label at the bottom (default: TỰ PHÁT TRIỂN)", "vi": "Nhãn chữ in nhỏ (mặc định TỰ PHÁT TRIỂN)" }
        }
      }
    },
    "cta-followup": {
      "id": "cta-followup",
      "name": {
        "en": "CTA Followup",
        "vi": "CTA Kết Bài"
      },
      "description": {
        "en": "Outro — thank-you line + pulsing red CTA button. Use ONCE as the last scene.",
        "vi": "Outro — câu cảm ơn + nút CTA đỏ pulsing. Dùng MỘT LẦN cho cảnh cuối."
      },
      "role": "outro",
      "slots": {
        "voiceText": {
          "type": "string",
          "required": true,
          "maxLength": 80,
          "label": { "en": "Thanks / sign-off", "vi": "Câu cảm ơn / kết bài" }
        },
        "cta": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "label": { "en": "CTA button (all caps)", "vi": "Nút CTA (in hoa)" }
        }
      }
    },
    "insight-card": {
      "id": "insight-card",
      "name": { "en": "Insight Card", "vi": "Thẻ Nguyên Tắc" },
      "description": {
        "en": "Numbered insight — red badge + huge orange number + short title + caption. Use for a discrete principle / rule / step.",
        "vi": "Insight có số — badge đỏ + số cam khổng lồ + tiêu đề ngắn + caption. Dùng cho một nguyên tắc / quy tắc / bước cụ thể."
      },
      "role": "body",
      "slots": {
        "badge": {
          "type": "string", "required": true, "maxLength": 20,
          "label": { "en": "Red badge (all caps)", "vi": "Badge đỏ (in hoa)" }
        },
        "number": {
          "type": "string", "required": true, "maxLength": 3,
          "label": { "en": "Big number", "vi": "Số lớn" }
        },
        "title": {
          "type": "string", "required": true, "maxLength": 32,
          "label": { "en": "Short title (≤ 6 words)", "vi": "Tiêu đề ngắn (≤ 6 từ)" }
        },
        "voiceText": {
          "type": "string", "required": true, "maxLength": 180,
          "label": { "en": "Caption (narrator reads)", "vi": "Caption (người dẫn đọc)" }
        }
      }
    },
    "stat-callout": {
      "id": "stat-callout",
      "name": { "en": "Stat Callout", "vi": "Callout Con Số" },
      "description": {
        "en": "One dominant statistic — huge red number + label + supporting caption. Use when a research figure carries the beat.",
        "vi": "Một con số nổi bật — số đỏ khổng lồ + nhãn + caption. Dùng khi 1 số liệu nghiên cứu là điểm nhấn."
      },
      "role": "body",
      "slots": {
        "kicker": {
          "type": "string", "required": true, "maxLength": 24,
          "label": { "en": "Small kicker", "vi": "Nhãn nhỏ" }
        },
        "stat": {
          "type": "string", "required": true, "maxLength": 8,
          "label": { "en": "The number (e.g. 66 or 82%)", "vi": "Con số (ví dụ 66 hoặc 82%)" }
        },
        "label": {
          "type": "string", "required": true, "maxLength": 40,
          "label": { "en": "What the number means", "vi": "Con số nghĩa là gì" }
        },
        "voiceText": {
          "type": "string", "required": true, "maxLength": 180,
          "label": { "en": "Caption (narrator reads)", "vi": "Caption (người dẫn đọc)" }
        }
      }
    },
    "checklist-panel": {
      "id": "checklist-panel",
      "name": { "en": "Checklist Panel", "vi": "Bảng Checklist" },
      "description": {
        "en": "2–4 checked items with animated checkmarks + a stamp title. Use for actionable list of daily habits / steps.",
        "vi": "2–4 mục đánh dấu với check animation + tiêu đề đóng dấu. Dùng cho danh sách thói quen / bước hành động."
      },
      "role": "body",
      "slots": {
        "title": {
          "type": "string", "required": true, "maxLength": 32,
          "label": { "en": "Title stamp (all caps)", "vi": "Tiêu đề đóng dấu (in hoa)" }
        },
        "item1": {
          "type": "string", "required": true, "maxLength": 40,
          "label": { "en": "Item 1", "vi": "Mục 1" }
        },
        "item2": {
          "type": "string", "required": true, "maxLength": 40,
          "label": { "en": "Item 2", "vi": "Mục 2" }
        },
        "item3": {
          "type": "string", "maxLength": 40,
          "label": { "en": "Item 3 (optional)", "vi": "Mục 3 (tuỳ chọn)" }
        },
        "item4": {
          "type": "string", "maxLength": 40,
          "label": { "en": "Item 4 (optional)", "vi": "Mục 4 (tuỳ chọn)" }
        }
      }
    }
  },

  "wizard": {
    "supportsUrl": true,
    "ideaPlaceholder": {
      "en": "e.g. Why you never stick to habits — 3 mental traps that break motivation on day 4.",
      "vi": "VD: Tại sao bạn không kỷ luật được — 3 bẫy tư duy làm mất động lực từ ngày thứ 4."
    },
    "urlPlaceholder": {
      "en": "https://vnexpress.net/tam-ly-hoc-tao-thoi-quen",
      "vi": "https://vnexpress.net/tam-ly-hoc-tao-thoi-quen"
    }
  },

  "extraSceneFields": {
    "emotion": {
      "type": "enum",
      "values": ["tired", "motivated", "frustrated", "energetic", "curious"],
      "default": "curious",
      "label": "Cảm xúc nhân vật"
    },
    "keyPoint": {
      "type": "string",
      "label": "1 câu chốt (nếu có)"
    }
  }
}
