{
  "id": "news-poster-vn",
  "name": {
    "en": "News Poster (VN)",
    "vi": "Poster Tin Tức Việt"
  },
  "version": "1.0.0",
  "description": {
    "en": "Vietnamese editorial-poster short news — same 11 designer-grade templates forked from huytranvan2010/AI-auto-generate-video (MIT), tuned for Vietnamese typography (Be Vietnam Pro + Inter Tight fallback). Portrait 9:16 primary, 60-120s.",
    "vi": "Poster editorial tin tức tiếng Việt — 11 template chất lượng thiết kế fork từ huytranvan2010/AI-auto-generate-video (MIT), tối ưu chữ Việt (Be Vietnam Pro + Inter Tight). Dọc 9:16 chính, 60-120 giây."
  },
  "author": "aivideoultimate",
  "license": "MIT",
  "repository": "https://github.com/chrisangle/ai_ultimate_fable_packs",

  "target": {
    "language": "vi",
    "market": ["vi-VN"],
    "audience": "adult",
    "genre": "news-poster",
    "aspectRatio": "9:16",
    "supportedAspects": ["9:16", "16:9"],
    "duration": { "min": 60, "target": 90, "max": 180 }
  },

  "compat": { "core": ">=1.0.0" },

  "assets": {
    "templates": "templates",
    "voice": "voice",
    "style": "style/tokens.css"
  },

  "prompts": {
    "script": "prompts/script.md",
    "scene": "prompts/scene.md"
  },

  "voice": {
    "referenceClip": "voice/ref-narrator-vn.mp3",
    "defaultVoiceId": "news-poster-narrator-vn",
    "language": "vi"
  },

  "scenes": {
    "defaultTemplate": "frame-vignelli",
    "hookTemplate": "frame-liquid-bg-hero",
    "outroTemplate": "frame-logo-outro",
    "beatStructure": ["hook", "bối cảnh", "con số", "insight", "so sánh", "danh sách", "outro"]
  },

  "templateCatalog": {
    "frame-liquid-bg-hero": {
      "id": "frame-liquid-bg-hero",
      "name": { "en": "Aurora Hero", "vi": "Aurora Hero" },
      "description": {
        "en": "Opening hook — aurora liquid background + hero headline. Use ONCE as scene 1.",
        "vi": "Mở đầu — nền aurora + tiêu đề chính. Dùng MỘT LẦN cho cảnh 1."
      },
      "role": "hook",
      "slots": {
        "kicker":     { "type": "string", "required": true, "maxLength": 32 },
        "brand":      { "type": "string", "maxLength": 40 },
        "headline":   { "type": "string", "required": true, "maxLength": 60 },
        "subheadline":{ "type": "string", "maxLength": 100 },
        "cta":        { "type": "string", "maxLength": 32 }
      }
    },
    "frame-vignelli":            { "id": "frame-vignelli",            "name": { "en": "Vignelli Stat",       "vi": "Vignelli Stat" },       "description": { "en": "Dark charcoal + red — one striking number.",         "vi": "Nền than + đỏ — 1 số nổi bật." }, "role": "body", "slots": { "kicker": { "type": "string", "maxLength": 32 }, "number": { "type": "string", "required": true, "maxLength": 12 }, "label": { "type": "string", "required": true, "maxLength": 40 }, "note": { "type": "string", "maxLength": 80 }, "brand": { "type": "string", "maxLength": 40 } } },
    "frame-pentagram-stat":      { "id": "frame-pentagram-stat",      "name": { "en": "Pentagram Stat",      "vi": "Pentagram Stat" },      "description": { "en": "Dark neon + orange + cyan + bar chart.",             "vi": "Nền tối neon + cam + cyan + bar chart." }, "role": "body", "slots": { "label": { "type": "string", "required": true, "maxLength": 40 }, "headline": { "type": "string", "required": true, "maxLength": 12 }, "subtitle": { "type": "string", "required": true, "maxLength": 80 }, "anchor": { "type": "string", "maxLength": 12 }, "footer_left": { "type": "string", "maxLength": 40 }, "footer_right": { "type": "string", "maxLength": 40 } } },
    "frame-bold-poster":         { "id": "frame-bold-poster",         "name": { "en": "Bold Poster",         "vi": "Bold Poster" },         "description": { "en": "Multi-line statement + giant figure.",                 "vi": "Tuyên bố nhiều dòng + số khổng lồ." }, "role": "body", "slots": { "kicker": { "type": "string", "maxLength": 32 }, "date": { "type": "string", "maxLength": 24 }, "figure": { "type": "string", "required": true, "maxLength": 12 }, "headline": { "type": "string[]", "required": true }, "standfirst": { "type": "string", "maxLength": 180 }, "footer_left": { "type": "string", "maxLength": 40 }, "footer_right": { "type": "string", "maxLength": 40 } } },
    "frame-build-minimal":       { "id": "frame-build-minimal",       "name": { "en": "Build Minimal",       "vi": "Build Minimal" },       "description": { "en": "1 bold word reveal + amber glow.",                     "vi": "1 từ lớn hiện từng ký tự + glow cam." }, "role": "body", "slots": { "eyebrow": { "type": "string", "maxLength": 32 }, "hero": { "type": "string", "required": true, "maxLength": 16 }, "desc": { "type": "string", "maxLength": 120 }, "side_left": { "type": "string", "maxLength": 24 }, "side_right": { "type": "string", "maxLength": 24 } } },
    "frame-creative-voltage":    { "id": "frame-creative-voltage",    "name": { "en": "Creative Voltage",    "vi": "Creative Voltage" },    "description": { "en": "Electric-blue split + handwriting accent — slogan.",   "vi": "Xanh điện split + viết tay — slogan." }, "role": "body", "slots": { "meta": { "type": "string", "maxLength": 32 }, "display_lines": { "type": "string[]", "required": true }, "accent_index": { "type": "string", "maxLength": 4 }, "script": { "type": "string", "maxLength": 40 }, "caption": { "type": "string", "maxLength": 120 } } },
    "frame-glitch-title":        { "id": "frame-glitch-title",        "name": { "en": "Glitch Title",        "vi": "Glitch Title" },        "description": { "en": "Cyberpunk RGB glitch — breaking/tech beats.",           "vi": "Cyberpunk RGB glitch — beat breaking/tech." }, "role": "body", "slots": { "title": { "type": "string", "required": true, "maxLength": 60 }, "subtitle": { "type": "string", "maxLength": 120 } } },
    "frame-aicoding-list":       { "id": "frame-aicoding-list",       "name": { "en": "Icon List",           "vi": "Danh Sách Icon" },      "description": { "en": "2–5 items with icons + level tags.",                   "vi": "2–5 mục với icon + tag mức độ." }, "role": "body", "slots": { "title": { "type": "string", "required": true, "maxLength": 40 }, "accent": { "type": "string", "maxLength": 40 }, "accent_from": { "type": "color", "maxLength": 12 }, "accent_to": { "type": "color", "maxLength": 12 }, "subtitle": { "type": "string", "maxLength": 120 }, "items": { "type": "string[]", "required": true } } },
    "frame-aicoding-comparison": { "id": "frame-aicoding-comparison", "name": { "en": "A vs B",              "vi": "A vs B" },              "description": { "en": "2-card comparison — old vs new, before vs after.",     "vi": "So sánh 2 card — cũ vs mới, trước vs sau." }, "role": "body", "slots": { "badge": { "type": "string", "maxLength": 32 }, "pre": { "type": "string", "maxLength": 40 }, "vs": { "type": "string", "maxLength": 8 }, "post": { "type": "string", "maxLength": 40 }, "left": { "type": "string", "required": true }, "right": { "type": "string", "required": true } } },
    "frame-logo-outro":          { "id": "frame-logo-outro",          "name": { "en": "Logo Outro",          "vi": "Logo Outro" },          "description": { "en": "Brand end-card. Default outro.",                       "vi": "End-card thương hiệu. Outro mặc định." }, "role": "outro", "slots": { "brand_name": { "type": "string", "required": true, "maxLength": 40 }, "tagline": { "type": "string", "maxLength": 80 }, "primary_url": { "type": "url", "maxLength": 100 } } },
    "frame-statement-outro":     { "id": "frame-statement-outro",     "name": { "en": "Statement Outro",     "vi": "Statement Outro" },     "description": { "en": "Alt outro — red statement on paper.",                  "vi": "Outro thay thế — card đỏ trên giấy." }, "role": "outro", "slots": { "statement": { "type": "string", "required": true, "maxLength": 120 }, "brand": { "type": "string", "maxLength": 40 }, "primary_url": { "type": "url", "maxLength": 100 }, "cta": { "type": "string", "maxLength": 32 }, "channel": { "type": "string", "maxLength": 40 }, "source": { "type": "string", "maxLength": 60 } } }
  }
}
